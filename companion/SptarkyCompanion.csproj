<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- On, because nullability is load-bearing here: a server box legitimately has no client
         half, so ClientRoot being null is a real state the code must keep handling rather than
         a case to assume away. -->
    <Nullable>enable</Nullable>
    <AssemblyName>SptarkyCompanion</AssemblyName>
    <RootNamespace>SptarkyCompanion</RootNamespace>
    <!-- A mod is loaded by the server; it must not drag its own copies of SPT's assemblies
         into user/mods, or two versions of the same type end up in the process. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Referenced straight out of an SPT install rather than a NuGet feed: SPT does not
       publish these, and the version that matters is the one the server actually runs.
       SptDir is overridable so this can build against 4.1.x without editing the project. -->
  <PropertyGroup>
    <SptDir Condition="'$(SptDir)' == ''">D:\SPT\SPT</SptDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptDir)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptDir)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptDir)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptDir)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
